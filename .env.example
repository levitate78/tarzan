# Copy to .env and fill in real values. Never commit .env.
# Database encryption passphrase (SQLCipher key derivation). Long and random.
TARZAN_DB_KEY=change-me-to-a-long-random-value
# Flask session signing key. Long and random, different from TARZAN_DB_KEY.
TARZAN_SECRET_KEY=change-me-to-another-long-random-value
# Team manager login.
TARZAN_ADMIN_USERNAME=manager
TARZAN_ADMIN_PASSWORD=change-me
# Enforce HTTPS redirects outside localhost (set true behind TLS).
TARZAN_HTTPS_ENFORCE=false
# Host port for docker-compose.
TARZAN_PORT=8000
