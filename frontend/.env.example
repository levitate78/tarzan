# Used only by `npm run dev` (vite.config.ts proxy target). The production
# nginx container always proxies /api to the "backend" service directly —
# see frontend/nginx.conf.
VITE_BACKEND_URL=http://localhost:8000

# Optional: override the API base path used by the frontend at runtime.
# Defaults to "/api/v1", which works with both the Vite dev proxy and the
# production nginx reverse proxy.
# VITE_API_BASE_URL=/api/v1
