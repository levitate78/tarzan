## Copy this to .env and fill in secrets for local development
# Database
DATABASE_URL=postgresql+asyncpg://tarzan:tarzan@postgres:5432/tarzan

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=replace-with-32+chars-or-more-xxxxxxxxxxxxxxxxxxxx
# Generate a 32-byte base64url key, for example (python):
# import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))
FIELD_ENCRYPTION_KEY=replace-with-base64url-32-byte-key

# App
ENVIRONMENT=development
DEBUG=true

# CORS — add the origin(s) the frontend is served from
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Initial admin bootstrap (created automatically on first startup if the
# users table is empty). Remove/blank these out once the admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please-12345
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrator
